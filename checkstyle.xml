<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="severity" value="warning"/>

    <!-- Строка не длиннее 120 символов -->
    <module name="LineLength">
        <property name="max" value="120"/>
    </module>

    <!-- Запрет табуляции, отступы только пробелами -->
    <module name="FileTabCharacter"/>

    <!-- Запрет пробелов в конце строки -->
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Пробелы в конце строки"/>
    </module>

    <module name="TreeWalker">
        <!-- Имена: классы с большой буквы, методы и переменные с маленькой -->
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>

        <!-- Импорты: без import xxx.*, без неиспользуемых -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>

        <!-- if/for/while всегда с фигурными скобками -->
        <module name="NeedBraces"/>

        <!-- Вместо System.out.println нужно использовать Logger -->
        <module name="Regexp">
            <property name="format" value="System\.out\.println"/>
            <property name="illegalPattern" value="true"/>
            <property name="message" value="Используйте Logger вместо System.out.println"/>
        </module>
    </module>
</module>
